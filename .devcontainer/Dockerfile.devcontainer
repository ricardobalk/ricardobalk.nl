FROM debian:bookworm-slim

LABEL org.opencontainers.image.title="r4.do DevContainer" \
      org.opencontainers.image.description="VSCode editor environment for Ricardo Balk's personal website" \
      org.opencontainers.image.source="https://github.com/ricardobalk/personal-website" \
      org.opencontainers.image.url="https://r4.do" \
      org.opencontainers.image.authors="Ricardo Balk" \
      org.opencontainers.image.licenses="ISC" \
      internal="1"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git gnupg openssh-client procps \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --user-group --uid 1000 --shell /bin/bash vscode

ENV LANG=C.UTF-8

USER vscode
RUN mkdir -p /home/vscode/.vscode-server/extensions
WORKDIR /home/node/app

CMD ["sleep", "infinity"]
